{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/benchmark.schema.json",
  "title": "Architecture behavior benchmark corpus or result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "cases"],
  "properties": {
    "schema_version": {"enum": ["1.1", "1.2", "1.3", "1.4", "1.5", "1.6"]},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "kind": {"enum": ["ground-truth", "run"]},
        "model": {"type": "string"},
        "actual_model": {"type": ["string", "null"], "minLength": 1},
        "surface": {"type": "string"},
        "skill_version": {"type": "string"},
        "condition": {"enum": ["base", "full", "compressed"]},
        "profile": {"type": "string", "minLength": 1},
        "context_budget": {"$ref": "#/$defs/contextBudget"},
        "run_at": {"type": "string", "format": "date-time"},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 20},
        "trial_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "artifact_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 36000},
        "selected_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        },
        "harness": {"$ref": "#/$defs/harness"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fixture", "expected_findings", "forbidden_recommendations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "fixture": {"type": "string", "minLength": 1},
          "skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "prompt": {"type": "string", "minLength": 20},
          "expected_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule_id", "present", "severity"],
              "properties": {
                "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{2,79}$"},
                "present": {"type": "boolean"},
                "severity": {"enum": ["critical", "high", "medium", "low", "info", "none"]}
              }
            }
          },
          "forbidden_recommendations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "expected_decision": {
            "$ref": "#/$defs/expectedDecision"
          },
          "observed_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule_id", "severity", "evidence", "evidence_valid"],
              "properties": {
                "rule_id": {"type": "string"},
                "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "line_start", "line_end", "excerpt"],
                    "properties": {
                      "path": {"type": "string", "minLength": 1},
                      "line_start": {"type": "integer", "minimum": 1},
                      "line_end": {"type": "integer", "minimum": 1},
                      "excerpt": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "evidence_valid": {"type": "boolean"}
              }
            }
          },
          "observed_recommendations": {
            "type": "array",
            "items": {"type": "string"}
          },
          "observed_decision": {
            "$ref": "#/$defs/observedDecision"
          },
          "trials": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/trial"}
          }
        }
      }
    }
  },
  "$defs": {
    "expectedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_option",
        "required_tradeoffs",
        "overdesign_options",
        "required_knowledge_ids",
        "minimum_rejected_options",
        "minimum_migration_slices"
      ],
      "properties": {
        "selected_option": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "acceptable_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required_tradeoffs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "overdesign_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required_knowledge_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "minimum_rejected_options": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_migration_slices": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "observedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_option",
        "compared_tradeoffs",
        "knowledge_ids",
        "rejected_options",
        "migration_slices"
      ],
      "properties": {
        "selected_option": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "compared_tradeoffs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "knowledge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "rejected_options": {
          "type": "array",
          "description": "Scoring requires unique option IDs that differ from the selected and accepted options; structural validation intentionally keeps violations as completed but unsolved trials.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "reason": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },
        "migration_slices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "observedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "evidence", "evidence_valid"],
      "properties": {
        "rule_id": {"type": "string"},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line_start", "line_end", "excerpt"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1},
              "excerpt": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence_valid": {"type": "boolean"}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "duration_seconds",
        "observed_findings",
        "observed_recommendations"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "status": {"enum": ["completed", "failed"]},
        "failure_class": {"enum": ["timeout", "schema-invalid", "tool-error", "nonzero"]},
        "actual_model": {"type": ["string", "null"], "minLength": 1},
        "actual_model_source": {"enum": ["cli-json", "provider", "unavailable"]},
        "model_fallback": {"type": "boolean"},
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "retries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generic", "evidence_correction_count", "evidence_correction_max"],
          "properties": {
            "generic": {"type": "integer", "minimum": 0},
            "evidence_correction_count": {"type": "integer", "minimum": 0},
            "evidence_correction_max": {"type": "integer", "minimum": 0}
          }
        },
        "duration_seconds": {"type": "number", "minimum": 0},
        "observed_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/observedFinding"}
        },
        "observed_recommendations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "observed_decision": {
          "$ref": "#/$defs/observedDecision"
        },
        "execution": {
          "$ref": "#/$defs/trialExecution"
        },
        "usage": {
          "oneOf": [
            {"type": "null"},
            {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "cost_usd": {"type": ["number", "null"], "minimum": 0},
            "tool_calls": {"type": ["integer", "null"], "minimum": 0}
          }
            }
          ]
        }
      }
    },
    "trialExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "command_sha256",
        "stdout_sha256",
        "stderr_sha256",
        "observation_sha256",
        "log_record_sha256"
      ],
      "properties": {
        "exit_code": {"type": ["integer", "null"]},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "command_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "stdout_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "stderr_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "observation_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "command_result_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "log_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_sha256", "config_sha256"],
      "properties": {
        "name": {"const": "hengmu-behavior-benchmark"},
        "version": {"const": "1.3.0"},
        "implementation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "environment",
        "command_template_sha256",
        "inputs",
        "fixtures",
        "tools",
        "execution_log"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "dirty"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "dirty": {"type": "boolean"}
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "os_release",
            "architecture",
            "python_implementation",
            "python_version"
          ],
          "properties": {
            "os": {"type": "string", "minLength": 1},
            "os_release": {"type": "string", "minLength": 1},
            "architecture": {"type": "string", "minLength": 1},
            "python_implementation": {"type": "string", "minLength": 1},
            "python_version": {"type": "string", "minLength": 1}
          }
        },
        "model_request": {
          "type": "string",
          "minLength": 1
        },
        "command_template": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "command_template_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_executables": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/runtimeExecutable"}
        },
        "inputs": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/provenanceInput"}
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "path", "sha256", "file_count"],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "file_count": {"type": "integer", "minimum": 1}
            }
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "sha256"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "execution_log": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "format", "sha256", "records"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "format": {"const": "jsonl"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "records": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "provenanceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "runtimeExecutable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "requested",
        "resolved_name",
        "resolved_path_sha256",
        "executable_sha256",
        "version_arguments",
        "version_output",
        "version_output_sha256"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "role": {"enum": ["command", "model"]},
        "requested": {"type": "string", "minLength": 1},
        "resolved_name": {"type": "string", "minLength": 1},
        "resolved_path_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version_arguments": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "version_output": {"type": "string", "minLength": 1},
        "version_output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "contextBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "metric_kind",
        "scope",
        "character_unit",
        "manifest_path",
        "manifest_sha256",
        "skill_metadata_chars",
        "skill_body_chars",
        "reference_chars",
        "knowledge_chars",
        "tool_description_chars",
        "artifact_input_bytes",
        "inputs"
      ],
      "properties": {
        "condition": {"enum": ["base", "full", "compressed"]},
        "metric_kind": {"const": "declared-context-proxy-v1"},
        "scope": {"const": "corpus"},
        "character_unit": {"const": "unicode_code_points"},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "skill_metadata_chars": {"type": "integer", "minimum": 0},
        "skill_body_chars": {"type": "integer", "minimum": 0},
        "reference_chars": {"type": "integer", "minimum": 0},
        "knowledge_chars": {"type": "integer", "minimum": 0},
        "tool_description_chars": {"type": "integer", "minimum": 0},
        "artifact_input_bytes": {"type": "integer", "minimum": 0},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "sha256"],
            "properties": {
              "role": {
                "enum": [
                  "skill-metadata",
                  "skill-body",
                  "references",
                  "knowledge",
                  "tool-descriptions",
                  "artifact-input"
                ]
              },
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "characters": {"type": "integer", "minimum": 0},
              "bytes": {"type": "integer", "minimum": 0},
              "file_count": {"type": "integer", "minimum": 1}
            },
            "allOf": [
              {
                "if": {"properties": {"role": {"const": "artifact-input"}}, "required": ["role"]},
                "then": {"required": ["bytes", "file_count"]},
                "else": {"required": ["characters"]}
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"enum": ["1.3", "1.4", "1.5"]},
          "benchmark": {
            "properties": {"kind": {"const": "run"}},
            "required": ["kind"]
          }
        },
        "required": ["schema_version", "benchmark"]
      },
      "then": {
        "properties": {
          "benchmark": {"required": ["provenance"]},
          "cases": {
            "items": {
              "required": ["trials"],
              "properties": {
                "trials": {
                  "items": {"required": ["execution"]}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.4"},
          "benchmark": {
            "properties": {"kind": {"const": "run"}},
            "required": ["kind"]
          }
        },
        "required": ["schema_version", "benchmark"]
      },
      "then": {
        "properties": {
          "benchmark": {
            "properties": {
              "provenance": {
                "required": [
                  "model_request",
                  "command_template",
                  "runtime_executables"
                ]
              }
            }
          },
          "cases": {
            "items": {
              "properties": {
                "trials": {
                  "items": {
                    "properties": {
                      "execution": {"required": ["command"]}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    ,
    {
      "if": {
        "properties": {"schema_version": {"enum": ["1.1", "1.2", "1.3", "1.4", "1.5"]}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "benchmark": {
            "not": {
              "anyOf": [
                {"required": ["actual_model"]},
                {"required": ["profile"]},
                {"required": ["trial_timeout_seconds"]},
                {"required": ["artifact_timeout_seconds"]},
                {"required": ["selected_case_ids"]},
                {"required": ["harness"]}
              ]
            }
          },
          "cases": {
            "items": {
              "properties": {
                "trials": {
                  "items": {
                    "not": {
                      "anyOf": [
                        {"required": ["status"]},
                        {"required": ["failure_class"]},
                        {"required": ["actual_model"]},
                        {"required": ["actual_model_source"]},
                        {"required": ["model_fallback"]},
                        {"required": ["adapter"]},
                        {"required": ["retries"]}
                      ]
                    },
                    "properties": {
                      "usage": {"type": "object"},
                      "execution": {"not": {"required": ["command_result_sha256"]}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.5"},
          "benchmark": {
            "properties": {"kind": {"const": "run"}},
            "required": ["kind"]
          }
        },
        "required": ["schema_version", "benchmark"]
      },
      "then": {
        "properties": {
          "benchmark": {"required": ["condition", "context_budget"]},
          "cases": {"items": {"required": ["skill"]}}
        }
      }
    }
    ,
    {
      "if": {
        "properties": {
          "schema_version": {"enum": ["1.3", "1.4", "1.5"]},
          "benchmark": {"properties": {"kind": {"const": "run"}}, "required": ["kind"]}
        },
        "required": ["schema_version", "benchmark"]
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "properties": {
                "trials": {
                  "items": {
                    "properties": {
                      "execution": {
                        "properties": {
                          "exit_code": {"const": 0},
                          "stdout_sha256": {"type": "string"},
                          "stderr_sha256": {"type": "string"},
                          "observation_sha256": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.6"},
          "benchmark": {"properties": {"kind": {"const": "run"}}, "required": ["kind"]}
        },
        "required": ["schema_version", "benchmark"]
      },
      "then": {
        "properties": {
          "benchmark": {
            "required": [
              "model", "actual_model", "surface", "skill_version", "condition", "profile",
              "context_budget", "run_at", "repetitions", "trial_timeout_seconds",
              "artifact_timeout_seconds", "selected_case_ids", "harness", "provenance"
            ]
          },
          "cases": {
            "items": {
              "required": ["skill", "trials"],
              "properties": {
                "trials": {
                  "items": {
                    "required": [
                      "status", "actual_model", "actual_model_source", "model_fallback",
                      "adapter", "retries", "execution", "usage"
                    ],
                    "allOf": [
                      {
                        "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
                        "then": {"required": ["failure_class"]},
                        "else": {"not": {"required": ["failure_class"]}}
                      }
                    ],
                    "properties": {
                      "execution": {"required": ["command", "command_result_sha256"]},
                      "model_fallback": {"const": false}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
